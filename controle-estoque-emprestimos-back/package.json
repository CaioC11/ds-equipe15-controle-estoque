{
  "name": "controle-estoque-emprestimos",
  "version": "1.0.0",
  "description": "Sistema de controle de estoque e empréstimos",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "lint": "biome check --write src/ test/",
    "lint:ci": "biome ci src/ test/",
    "format": "biome format --write src/ test/",
    "test": "vitest run",
    "test:v1": "vitest run tests/v1-llm --config vitest.llm.config.ts --coverage --coverage.reportsDirectory=./coverage/v1",
    "test:v2": "vitest run tests/v2 --config vitest.llm.config.ts --coverage --coverage.reportsDirectory=./coverage/v2",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "migration:generate": "prisma migrate dev --schema prisma/schema.prisma",
    "migration:run": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed": "prisma db seed",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/client": "^5.19.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jose": "^6.2.3",
    "nestjs-zod": "^5.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.63"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.24",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "husky": "^9.1.7",
    "prisma": "^5.19.1",
    "source-map-support": "^0.5.21",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "esbuild": true,
    "@nestjs/core": false,
    "@scarf/scarf": false,
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
